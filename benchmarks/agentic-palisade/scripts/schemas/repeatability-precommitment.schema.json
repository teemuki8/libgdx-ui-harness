{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-palisade:repeatability-precommitment:v1",
  "title": "Before-run Agentic Palisade release precommitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "candidateCommit", "candidateSourceSha256",
    "releaseVersion", "sealedAt", "dynamicMask", "statisticalMethod",
    "allocationSeed", "exclusionPolicy", "scenarioAssertionGroups",
    "observations", "precommitmentHashes", "costCeilings", "environments",
    "schedule", "profile", "precommitmentSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "agentic-palisade/repeatability-precommitment-v1"},
    "profile": {"type": "string", "enum": ["low-confidence", "high-confidence"]},
    "candidateCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateSourceSha256": {"$ref": "#/$defs/sha256"},
    "releaseVersion": {"type": "string"},
    "sealedAt": {"type": "string", "format": "date-time"},
    "dynamicMask": {"type": "null"},
    "statisticalMethod": {"const": "paired-randomization-test-v1"},
    "allocationSeed": {"type": "integer"},
    "exclusionPolicy": {"const": "rerun-both-arms-retain-original-v1"},
    "scenarioAssertionGroups": {"const": 25},
    "observations": {
      "const": ["initial-1920x1080", "bottom-1920x1080", "initial-1280x720"]
    },
    "precommitmentHashes": {"type": "object"},
    "costCeilings": {"type": "object"},
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "failFast": {"type": "boolean"}
        }
      }
    },
    "precommitmentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
