{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teemuki8.github.io/libgdx-ui-harness/agentic-palisade/run-record.schema.json",
  "title": "Agentic Palisade run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "pair",
    "treatment",
    "model",
    "reasoning",
    "timestamps",
    "wallTimeSeconds",
    "exit",
    "hashes",
    "paths",
    "telemetry",
    "rounds",
    "failures"
  ],
  "properties": {
    "schemaVersion": {"const": "agentic-palisade/run-record-v1"},
    "runId": {"type": "string", "format": "uuid"},
    "pair": {"type": "integer", "minimum": 1, "maximum": 3},
    "treatment": {"enum": ["baseline", "harness"]},
    "model": {"const": "openai-codex/gpt-5.6-sol:medium"},
    "reasoning": {"const": "medium"},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "wallTimeSeconds": {"type": "number", "minimum": 0},
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "code", "signal", "timedOut"],
      "properties": {
        "classification": {
          "enum": [
            "success",
            "timed_out",
            "nonzero_exit",
            "crashed",
            "telemetry_failure",
            "round_protocol_failure",
            "round_supervisor_failure",
            "input_integrity_failure",
            "candidate_integrity_failure"
          ]
        },
        "code": {"type": ["integer", "null"], "minimum": 0},
        "signal": {"type": ["integer", "null"], "minimum": 1},
        "timedOut": {"type": "boolean"}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "corpus",
        "template",
        "protocol",
        "instructions",
        "inputManifest",
        "treatmentAppendix",
        "treatmentOverlay",
        "initialCandidate",
        "finalCandidate"
      ],
      "properties": {
        "prompt": {"$ref": "#/$defs/sha256"},
        "corpus": {"$ref": "#/$defs/sha256"},
        "template": {"$ref": "#/$defs/sha256"},
        "protocol": {"$ref": "#/$defs/sha256"},
        "instructions": {"$ref": "#/$defs/sha256"},
        "inputManifest": {"$ref": "#/$defs/sha256"},
        "treatmentAppendix": {"$ref": "#/$defs/sha256"},
        "treatmentOverlay": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "initialCandidate": {"$ref": "#/$defs/sha256"},
        "finalCandidate": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "profileRoot",
        "cacheRoot",
        "sessionRoot",
        "artifactRoot",
        "stdout",
        "stderr",
        "sessionExport",
        "roundEvidence",
        "roundEvidenceHash",
        "runRecordHash"
      ],
      "properties": {
        "workspace": {"$ref": "#/$defs/relativePath"},
        "profileRoot": {"$ref": "#/$defs/relativePath"},
        "cacheRoot": {"$ref": "#/$defs/relativePath"},
        "sessionRoot": {"$ref": "#/$defs/relativePath"},
        "artifactRoot": {"$ref": "#/$defs/relativePath"},
        "stdout": {"$ref": "#/$defs/relativePath"},
        "stderr": {"$ref": "#/$defs/relativePath"},
        "sessionExport": {
          "anyOf": [
            {"$ref": "#/$defs/relativePath"},
            {"type": "null"}
          ]
        },
        "roundEvidence": {"$ref": "#/$defs/relativePath"},
        "roundEvidenceHash": {"$ref": "#/$defs/relativePath"},
        "runRecordHash": {"$ref": "#/$defs/relativePath"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "toolCalls",
        "edits",
        "builds",
        "launches",
        "screenshots",
        "captureEvents",
        "failedOperations",
        "traceTaxonomy"
      ],
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cacheRead", "cacheWrite", "reasoning"],
          "properties": {
            "input": {"$ref": "#/$defs/tokenCategory"},
            "output": {"$ref": "#/$defs/tokenCategory"},
            "cacheRead": {"$ref": "#/$defs/tokenCategory"},
            "cacheWrite": {"$ref": "#/$defs/tokenCategory"},
            "reasoning": {"$ref": "#/$defs/tokenCategory"}
          }
        },
        "toolCalls": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "edits": {"type": "integer", "minimum": 0},
        "builds": {"type": "integer", "minimum": 0},
        "launches": {"type": "integer", "minimum": 0},
        "screenshots": {"type": "integer", "minimum": 0},
        "captureEvents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempted",
            "schemaRejected",
            "accepted",
            "inspected",
            "compared",
            "stale",
            "completionUsed",
            "launcherCaptures"
          ],
          "properties": {
            "attempted": {"type": "integer", "minimum": 0},
            "schemaRejected": {"type": "integer", "minimum": 0},
            "accepted": {"type": "integer", "minimum": 0},
            "inspected": {"type": "integer", "minimum": 0},
            "compared": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0},
            "completionUsed": {"type": "integer", "minimum": 0},
            "launcherCaptures": {"type": "integer", "minimum": 0}
          }
        },
        "failedOperations": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/failedOperation"}
        },
        "traceTaxonomy": {"$ref": "#/$defs/traceTaxonomy"}
      }
    },
    "rounds": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/roundMarker"}
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase"],
        "properties": {
          "phase": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "toolCallId": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}
    },
    "tokenCategory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {"const": "available"},
            "value": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {"const": "unavailable"},
            "value": {"type": "null"}
          }
        }
      ]
    },
    "failedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name"],
      "properties": {
        "toolCallId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "traceTaxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "availability", "parserVersion", "batchId", "runId", "sessionId",
        "inputSha256", "sequenceBasis", "knownExclusions", "events",
        "captureAttempts", "captureLifecycle", "attributions", "joins"
      ],
      "properties": {
        "schemaVersion": {"const": "agentic-palisade/trace-taxonomy-v1"},
        "availability": {"enum": ["available", "unavailable"]},
        "parserVersion": {"type": "string", "minLength": 1, "maxLength": 128},
        "batchId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "runId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sessionId": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 16384},
            {"type": "null"}
          ]
        },
        "inputSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "sequenceBasis": {"type": "string", "minLength": 1, "maxLength": 1024},
        "knownExclusions": {
          "type": "array", "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "events": {
          "type": "array", "maxItems": 16384,
          "items": {"$ref": "#/$defs/traceEvent"}
        },
        "captureAttempts": {
          "type": "array", "maxItems": 4096,
          "items": {"$ref": "#/$defs/captureAttempt"}
        },
        "captureLifecycle": {
          "type": "object", "maxProperties": 4096,
          "additionalProperties": {"$ref": "#/$defs/captureOutcome"}
        },
        "attributions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capture", "semantic", "rendering", "workflow-loop"],
          "properties": {
            "capture": {"$ref": "#/$defs/attributionArray"},
            "semantic": {"$ref": "#/$defs/attributionArray"},
            "rendering": {"$ref": "#/$defs/attributionArray"},
            "workflow-loop": {"$ref": "#/$defs/attributionArray"}
          }
        },
        "joins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process", "rounds", "evaluation"],
          "properties": {
            "process": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "identity"],
              "properties": {
                "status": {"enum": ["available", "unavailable"]},
                "identity": {
                  "oneOf": [
                    {"type": "object", "maxProperties": 16},
                    {"type": "null"}
                  ]
                }
              }
            },
            "rounds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "identities"],
              "properties": {
                "status": {"enum": ["available", "partial", "unavailable"]},
                "identities": {
                  "type": "array", "maxItems": 3,
                  "items": {"type": "object", "maxProperties": 8}
                }
              }
            },
            "evaluation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "identity"],
              "properties": {
                "status": {"enum": ["available", "unavailable"]},
                "identity": {
                  "oneOf": [
                    {"type": "object", "maxProperties": 16},
                    {"type": "null"}
                  ]
                }
              }
            }
          }
        }
      }
    },
    "traceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "batchId", "runId", "sessionId", "sequence",
        "kind", "parentEventIds", "eventId"
      ],
      "properties": {
        "schemaVersion": {"const": "agentic-palisade/trace-event-v1"},
        "batchId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "runId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "minLength": 1, "maxLength": 16384},
        "parentEventIds": {
          "type": "array", "maxItems": 128,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "operation": {"type": "string", "minLength": 1, "maxLength": 16384},
        "requestId": {"$ref": "#/$defs/sha256"},
        "payloadSha256": {"$ref": "#/$defs/sha256"},
        "evidenceClass": {
          "enum": ["observed", "source-established-cause", "hypothesis"]
        },
        "errorClass": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 1024},
            {"type": "null"}
          ]
        },
        "attemptId": {"$ref": "#/$defs/sha256"},
        "eventId": {"$ref": "#/$defs/sha256"}
      }
    },
    "captureAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId", "requestId", "operation", "payloadSha256", "source",
        "replayOfPayloadSha256", "result", "batchId", "runId", "sessionId",
        "sequence", "requestEventId", "resultEventId", "outcomeEventId"
      ],
      "properties": {
        "attemptId": {"$ref": "#/$defs/sha256"},
        "batchId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "runId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sequence": {"type": "integer", "minimum": 0},
        "requestEventId": {"$ref": "#/$defs/sha256"},
        "resultEventId": {"$ref": "#/$defs/sha256"},
        "outcomeEventId": {"$ref": "#/$defs/sha256"},
        "requestId": {"$ref": "#/$defs/sha256"},
        "operation": {"type": "string", "minLength": 1, "maxLength": 1024},
        "payloadSha256": {"$ref": "#/$defs/sha256"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "sha256"],
          "properties": {
            "kind": {"type": "string", "minLength": 1, "maxLength": 128},
            "name": {"type": "string", "minLength": 1, "maxLength": 16384},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "replayOfPayloadSha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "result": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "isError", "code", "succeeded", "artifactCreated",
                "inspected", "compared", "stale"
              ],
              "properties": {
                "isError": {"type": "boolean"},
                "code": {
                  "oneOf": [
                    {"type": "string", "minLength": 1, "maxLength": 1024},
                    {"type": "null"}
                  ]
                },
                "succeeded": {"type": "boolean"},
                "artifactCreated": {"type": "boolean"},
                "inspected": {"type": "boolean"},
                "compared": {"type": "boolean"},
                "stale": {"type": "boolean"}
              }
            }
          ]
        }
      }
    },
    "captureOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "terminal", "states"],
      "properties": {
        "channel": {"enum": ["harness", "launcher"]},
        "terminal": {
          "enum": [
            "requested", "schema-rejected", "execution-failed", "succeeded",
            "artifact-created"
          ]
        },
        "states": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {
            "enum": [
              "requested", "schema-rejected", "execution-failed", "succeeded",
              "artifact-created", "inspected", "compared-current", "stale"
            ]
          }
        }
      }
    },
    "attributionArray": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/attribution"}
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "family", "evidenceClass", "ruleId",
        "eventIds", "observation"
      ],
      "properties": {
        "schemaVersion": {"const": "agentic-palisade/trace-taxonomy-v1"},
        "family": {
          "enum": ["capture", "semantic", "rendering", "workflow-loop"]
        },
        "evidenceClass": {
          "enum": ["observed", "source-established-cause", "hypothesis"]
        },
        "ruleId": {"type": "string", "minLength": 1, "maxLength": 16384},
        "eventIds": {
          "type": "array", "maxItems": 16384,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "observation": {
          "type": "object", "maxProperties": 64
        }
      }
    },
    "roundMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "round",
        "accepted",
        "timestamp",
        "candidateHash",
        "requestId",
        "gateDigest",
        "channel"
      ],
      "properties": {
        "schemaVersion": {"const": "agentic-palisade/round-v1"},
        "round": {"type": "integer", "minimum": 1, "maximum": 3},
        "accepted": {"const": true},
        "timestamp": {"type": "string", "format": "date-time"},
        "candidateHash": {"$ref": "#/$defs/sha256"},
        "requestId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "gateDigest": {"$ref": "#/$defs/sha256"},
        "channel": {"const": "runner-supervisor"}
      }
    }
  }
}
